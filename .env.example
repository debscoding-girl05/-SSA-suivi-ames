NODE_ENV=development
PORT=3000
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173

# Database (PostgreSQL / Supabase).
# Leave DATABASE_URL empty in local dev to use the in-memory fallback store.
# Example Supabase: postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres
DATABASE_URL=
DATABASE_SSL=false

# Notion integration
NOTION_TOKEN=
NOTION_DATABASE_ID=
NOTION_ROLE=
NOTION_USER_ID=
NOTION_STATUS_PROPERTY=Status
NOTION_DUE_DATE_PROPERTY=Due
NOTION_ROLE_PROPERTY=Role
NOTION_ASSIGNEE_PROPERTY=Assignee
NOTION_TITLE_PROPERTY=Name
NOTION_RETRY_ATTEMPTS=3
NOTION_RETRY_BASE_DELAY_MS=700
