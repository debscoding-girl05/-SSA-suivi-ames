NODE_ENV=development
PORT=3000
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173

# Database (PostgreSQL / Supabase).
# Leave DATABASE_URL empty in local dev to use the in-memory fallback store.
# Example Supabase: postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres
DATABASE_URL=
DATABASE_SSL=false

# Public URL of the frontend — used to build links embedded in emails
# (password reset, invitations) and in push notification payloads.
APP_URL=http://localhost:5173

# Email (Resend — https://resend.com). Leave empty in dev: emails are just
# logged to the console instead of sent. Required in production for password
# reset, invitations and the notification digest to actually reach anyone.
RESEND_API_KEY=
EMAIL_FROM=SSA <onboarding@resend.dev>

# Object storage for report attachments (photo of the paper fiche).
# Leave empty in dev to fall back to local disk (server/uploads) — but this
# MUST be set in production: Render's free tier has no persistent disk, so
# local files vanish on every redeploy. Get these from your Supabase project
# (Settings -> API) and create a private bucket named rapport-attachments
# (Storage -> New bucket, "Public bucket" OFF).
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_STORAGE_BUCKET=rapport-attachments

# Web Push (browser notifications) — free, no third-party account needed.
# Generate once with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@example.com

# Notion integration
NOTION_TOKEN=
NOTION_DATABASE_ID=
NOTION_ROLE=
NOTION_USER_ID=
NOTION_STATUS_PROPERTY=Status
NOTION_DUE_DATE_PROPERTY=Due
NOTION_ROLE_PROPERTY=Role
NOTION_ASSIGNEE_PROPERTY=Assignee
NOTION_TITLE_PROPERTY=Name
NOTION_RETRY_ATTEMPTS=3
NOTION_RETRY_BASE_DELAY_MS=700
